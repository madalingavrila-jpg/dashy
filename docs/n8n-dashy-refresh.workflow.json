{
  "name": "Dashy nightly data refresh",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 14 * * *"
            }
          ]
        }
      },
      "id": "schedule-1400",
      "name": "Daily 14:00 Bucharest",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 0],
      "notesInFlow": true,
      "notes": "Set workflow timezone to Europe/Bucharest. Do not activate until GitHub Action secrets + a manual dispatch succeed."
    },
    {
      "parameters": {
        "resource": "workflow",
        "operation": "dispatch",
        "owner": "boltable",
        "repository": "dashy",
        "workflowId": "dashy-data-refresh.yml",
        "ref": "main",
        "inputs": {
          "values": [
            {
              "name": "reason",
              "value": "={{ \"n8n-schedule-\" + $now.toISO() }}"
            }
          ]
        }
      },
      "id": "gh-dispatch",
      "name": "Dispatch dashy-data-refresh",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1.1,
      "position": [280, 0],
      "notesInFlow": true,
      "notes": "Attach a GitHub credential with actions:write + repo on boltable/dashy."
    }
  ],
  "connections": {
    "Daily 14:00 Bucharest": {
      "main": [[{ "node": "Dispatch dashy-data-refresh", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "timezone": "Europe/Bucharest",
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
