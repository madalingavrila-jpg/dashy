# Boltable / local server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
DASHY_CACHE_TTL_MS=300000

# Optional: published Google Sheet CSV/JSON URL (overrides data/dashboard.json)
# DASHBOARD_SHEET_URL=

# Optional: persist Settings target overrides to git on PUT /api/target-config (Boltable)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=boltable/dashy
# GITHUB_BRANCH=main

# Databricks SQL (required for npm run data:pull-databricks / nightly Action)
# DATABRICKS_HOST=https://bolt-common.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_WAREHOUSE_ID=
# DASHY_MAX_SYNC_AGE_HOURS=12
# DASHY_SKIP_FRESHNESS=1

# Optional: Slack bot for Bianca notify after ./scripts/refresh-and-deploy.sh
# SLACK_BOT_TOKEN=xoxb-...

# Optional: set when frontend is hosted separately from the API
# NEXT_PUBLIC_API_BASE=
