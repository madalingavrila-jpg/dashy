# Boltable / local server
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
DASHY_CACHE_TTL_MS=300000

# Optional: published Google Sheet CSV/JSON URL (overrides data/dashboard.json)
# DASHBOARD_SHEET_URL=

# Boltable File Storage (S3) — IRSA in production; defaults match boltable-dashy
# S3_BUCKET=boltable-dashy
# S3_REGION=eu-central-1
# BOLTABLE_FILE_STORAGE=1

# Optional: Bearer token for laptop → live publish without AWS CLI
# (set the same value on Boltable and locally)
# DASHY_PUBLISH_TOKEN=

# Optional: set when frontend is hosted separately from the API
# NEXT_PUBLIC_API_BASE=
